<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Tringapps" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/tringapps_background</item>
    </style>

    <!-- Android 12+ SplashScreen API (back-ported by core-splashscreen). -->
    <style name="Theme.Tringapps.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/tringapps_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Tringapps</item>
    </style>
</resources>
